# Options required by the FEAT_NMI test suite.  Merge with your platform
# defconfig, for example:
#   scripts/kconfig/merge_config.sh -m -O build/hw build/hw/.config \
#       configs/nmi.config
#   make O=build/hw olddefconfig
CONFIG_ARM64_NMI=y
CONFIG_ARM64_PSEUDO_NMI=y
CONFIG_DEBUG_FS=y
CONFIG_GENERIC_IRQ_DEBUGFS=y
CONFIG_MODULES=y
CONFIG_SMP=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
# Runtime checks for the DAIF/PMR/ALLINT exception-state refactor.
CONFIG_DEBUG_IRQFLAGS=y
# Used to validate ALLINT instruction probing rejection and NMI kprobe paths.
CONFIG_KPROBES=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_TEST_LOCKUP=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_WERROR is not set
